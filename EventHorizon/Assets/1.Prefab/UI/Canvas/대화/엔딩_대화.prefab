      propertyPath: dialogueSets.Array.data[2].lines.Array.data[0]
      value: "\uc8fc\uc778\uc774 \ucc45\uc744 \ub36e\ub294\ub2e4. \ubc29 \uc548\uc758 \uacf5\uae30\uac00 \ubb34\uac81\uac8c \uc9d3\ub20c\ub9b0\ub2e4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].lines.Array.data[1]
      value: "\u2026\u2026\uadf8\ub798\ub3c4, \ub2f9\uc2e0 \ucc45\uc7a5\uc5d0\ub294 \uaf42\ud788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].lines.Array.data[2]
      value: "\uadf8\ub798. \uc0ad\uc81c\ub77c\uace0 \ub9d0\ud588\uc796\uc544."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
