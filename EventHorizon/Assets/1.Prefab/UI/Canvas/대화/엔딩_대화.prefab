      value: end3
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[3].conditionKey
      value: end4
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[3].lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[0]
      value: "\uB9C8\uC9C0\uB9C9 \uC11C\uAC00 \uB108\uBA38, \uD5C8\uACF5\uC5D0 \uCC45\uC744
        \uD3BC\uCE5C \uC5EC\uC790\uAC00 \uB5A0 \uC788\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[0]
      value: "\uC0DD\uAC01\uBCF4\uB2E4 \uC624\uB798 \uAC78\uB838\uB124? \uB098\uB294
        \uC774 \uC11C\uACE0\uC758 \uC8FC\uC778\uC774\uC57C. \uB0B4 \uBD80\uD558\uB4E4\uC744
        \uB9CE\uC774\uB3C4 \uBD80\uC234 \uBA39\uC5C8\uB354\uB77C?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[1]
      value: "\uBB50, \uB410\uC5B4. \uADF8\uB7F0 \uAC78 \uCC0D\uC5B4 \uB0B4\uB294
        \uAC74 \uC77C\uB3C4 \uC544\uB2C8\uB2C8\uAE4C. \uADF8\uB9AC\uACE0 \uC774\uC81C,
        \uB124 \uB0A8\uC740 8\uD37C\uC13C\uD2B8\uB97C \uBC1B\uC544 \uB458 \uCC28\uB840\uC57C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[2]
      value: "\uAC70\uC808\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uC800\uB294 \uCC45\uC774
        \uB418\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[3]
      value: "\uBF51\uD600 \uB098\uAC04 92\uD37C\uC13C\uD2B8\uB3C4 \uB3CC\uB824\uBC1B\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[4]
      value: "\u202690\uD37C\uC13C\uD2B8\uAC00 \uB118\uAC8C \uCD94\uCD9C\uB410\uB294\uB370\uB3C4
        \uAC70\uBD80\uC5D0 \uB300\uD55C \uC815\uBCF4\uAC00 \uC788\uB2E4\uACE0\u2026?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[5]
      value: "\uC774\uAC74 \uC880 \uC704\uD5D8\uD55C\uB370. \uC7A5\uC11C\uB85C \uB458
        \uC218 \uC5C6\uC744 \uAC83 \uAC19\uC544."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[6]
      value: "\uAE30\uB85D\uC740 \uC5C6\uB358 \uAC78\uB85C \uD560\uAC8C. \uC81C\uAC70\uAC00
        \uB0AB\uACA0\uC5B4. \uC774\uD574\uD558\uC9C0?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].lines.Array.data[0]
      value: "\uC8FC\uC778\uC774 \uCC45\uC744 \uB36E\uB294\uB2E4. \uBC29 \uC548\uC758
        \uACF5\uAE30\uAC00 \uBB34\uAC81\uAC8C \uC9D3\uB20C\uB9B0\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].lines.Array.data[1]
      value: "\u2026\u2026\uADF8\uB798\uB3C4, \uB2F9\uC2E0 \uCC45\uC7A5\uC5D0\uB294
        \uAF42\uD788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].lines.Array.data[2]
      value: "\uADF8\uB798. \uC0AD\uC81C\uB77C\uACE0 \uB9D0\uD588\uC796\uC544."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[3].lines.Array.data[0]
      value: "\uBAB8\uC774 \uC0B0\uC0B0\uC870\uAC01 \uB098\uACE0, \uC2DC\uAC01 \uC13C\uC11C\uAC00
        \uB04A\uACBC\uB2E4. \uB208\uC774 \uD750\uB824\uC9C0\uACE0, \uC774\uD6C4\uB294
        \uBA54\uBAA8\uB9AC\uC5D0 \uAE30\uB85D\uB418\uC5B4 \uC788\uC9C0 \uC54A\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].speakerIndex.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].speakerIndex.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].speakerIndex.Array.size
