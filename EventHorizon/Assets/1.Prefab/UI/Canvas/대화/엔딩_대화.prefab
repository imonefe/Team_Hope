    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[0]
      value: "\ub9c8\uc9c0\ub9c9 \uc11c\uac00 \ub108\uba38, \ud5c8\uacf5\uc5d0 \ucc45\uc744 \ud3bc\uce5c \uc5ec\uc790\uac00 \ub5a0 \uc788\ub2e4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].speakerIndex.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].speakerIndex.Array.data[0]
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[0]
      value: "\uc0dd\uac01\ubcf4\ub2e4 \uc624\ub798 \uac78\ub838\ub124? \ub098\ub294 \uc774 \uc11c\uace0\uc758 \uc8fc\uc778\uc774\uc57c. \ub0b4 \ubd80\ud558\ub4e4\uc744 \ub9ce\uc774\ub3c4 \ubd80\uc234 \uba39\uc5c8\ub354\ub77c?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[1]
      value: "\ubb50, \ub410\uc5b4. \uadf8\ub7f0 \uac78 \ucc0d\uc5b4 \ub0b4\ub294 \uac74 \uc77c\ub3c4 \uc544\ub2c8\ub2c8\uae4c. \uadf8\ub9ac\uace0 \uc774\uc81c, \ub124 \ub0a8\uc740 8\ud37c\uc13c\ud2b8\ub97c \ubc1b\uc544 \ub458 \ucc28\ub840\uc57c."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[2]
      value: "\uac70\uc808\ud558\uaca0\uc2b5\ub2c8\ub2e4. \uc800\ub294 \ucc45\uc774 \ub418\uc9c0 \uc54a\uaca0\uc2b5\ub2c8\ub2e4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[3]
      value: "\ubf51\ud600 \ub098\uac04 92\ud37c\uc13c\ud2b8\ub3c4 \ub3cc\ub824\ubc1b\uaca0\uc2b5\ub2c8\ub2e4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[4]
      value: "\u202690\ud37c\uc13c\ud2b8\uac00 \ub118\uac8c \ucd94\ucd9c\ub410\ub294\ub370\ub3c4 \uac70\ubd80\uc5d0 \ub300\ud55c \uc815\ubcf4\uac00 \uc788\ub2e4\uace0\u2026?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[5]
      value: "\uc774\uac74 \uc880 \uc704\ud5d8\ud55c\ub370. \uc7a5\uc11c\ub85c \ub458 \uc218 \uc5c6\uc744 \uac83 \uac19\uc544."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[6]
      value: "\uae30\ub85d\uc740 \uc5c6\ub358 \uac78\ub85c \ud560\uac8c. \uc81c\uac70\uac00 \ub0ab\uaca0\uc5b4. \uc774\ud574\ud558\uc9c0?"
      objectReference: {fileID: 0}
