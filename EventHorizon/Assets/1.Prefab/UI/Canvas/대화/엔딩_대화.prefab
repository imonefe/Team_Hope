      value: "\uD5E4\uB124\uC2DC"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: speakerNames.Array.data[1]
      value: "\uC11C\uACE0\uC758 \uC8FC\uC778"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: speakerNames.Array.data[2]
