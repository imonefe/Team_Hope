    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: speakerNames.Array.data[2]
      value: "\uc6a9\ubcd1"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].conditionKey
      value: shopIntro
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[0]
      value: "\uc654\ub2e4, \uc654\ub2e4! \uc5ec\uae30\uac00 \uc0c1\uc810\uc774\uc57c. \uc778\uc0ac\ud574, \ub0b4 \ub3d9\ub8cc\ub4e4\uc774\uc57c."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[1]
      value: "\uc0c8 \uc5bc\uad74\uc774\ub124. \ubb50, \ub098\uc57c \uc0c1\uad00\uc5c6\uc9c0\ub9cc. \ub9c8\uc74c\uaecf \ub458\ub7ec\ubd10. \ub3c8\ub9cc \uc788\uc73c\uba74 \ubb50\ub4e0 \uc88b\uc544."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[2]
      value: "\uc774\uacf3\uc5d0\uc11c \uac70\ub798\ub97c \ud558\ub294 \uac81\ub2c8\uae4c."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[3]
      value: "\uae08\uc11c\uace0\uc5d0\uc11c \uc0b4\uc544\ub0a8\ub294 \ubc29\ubc95\uc740 \ub450 \uac00\uc9c0\uc57c. \uc9c1\uc811 \uc2f8\uc6b0\uac70\ub098, \uc2f8\uc6b0\ub294 \ub188\ud55c\ud14c \ud314\uac70\ub098."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[4]
      value: "\u2026\uc548\ub4dc\ub85c\uc774\ub4dc\uad70\uc694. \uc18c\uc18d\uacfc \uc77c\ub828\ubc88\ud638\ub97c \ub9d0\uc500\ud558\uc2ed\uc2dc\uc624."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[5]
      value: "\uae30\uc5b5\ub098\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[6]
      value: "\uc2e0\uc6d0 \ubbf8\ud655\uc778\u2026 \uc88b\uc2b5\ub2c8\ub2e4, \uc784\uc2dc \ucd9c\uc785\uc744 \ud5c8\uac00\ud558\uc8e0. \uc804 \ubc31\uc774\uc5f0\uc785\ub2c8\ub2e4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].speakerIndex.Array.size
