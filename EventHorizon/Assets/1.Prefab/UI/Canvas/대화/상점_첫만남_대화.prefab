      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: speakerPortraits.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: speakerPortraits.Array.data[0]
      value: 
      objectReference: {fileID: 2174944303396829935}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: speakerPortraits.Array.data[1]
      value: 
      objectReference: {fileID: 2205124750801746297}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: speakerPortraits.Array.data[2]
      value: 
      objectReference: {fileID: 1242511395467413156}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: speakerPortraits.Array.data[3]
      value: 
      objectReference: {fileID: 8541494060253712191}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].conditionKey
      value: shopIntro
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].conditionKey
      value: demoEnding
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[0]
      value: "\uC654\uB2E4, \uC654\uB2E4! \uC5EC\uAE30\uAC00 \uC0C1\uC810\uC774\uC57C.
        \uC778\uC0AC\uD574, \uB0B4 \uB3D9\uB8CC\uB4E4\uC774\uC57C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[1]
      value: "\uC0C8 \uC5BC\uAD74\uC774\uB124. \uBB50, \uB098\uC57C \uC0C1\uAD00\uC5C6\uC9C0\uB9CC.
        \uB9C8\uC74C\uAECF \uB458\uB7EC\uBD10. \uB3C8\uB9CC \uC788\uC73C\uBA74 \uBB50\uB4E0
        \uC88B\uC544."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[2]
      value: "\uC774\uACF3\uC5D0\uC11C \uAC70\uB798\uB97C \uD558\uB294 \uAC81\uB2C8\uAE4C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[3]
      value: "\uAE08\uC11C\uACE0\uC5D0\uC11C \uC0B4\uC544\uB0A8\uB294 \uBC29\uBC95\uC740
        \uB450 \uAC00\uC9C0\uC57C. \uC9C1\uC811 \uC2F8\uC6B0\uAC70\uB098, \uC2F8\uC6B0\uB294
        \uB188\uD55C\uD14C \uD314\uAC70\uB098."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[4]
      value: "\u2026\uC548\uB4DC\uB85C\uC774\uB4DC\uAD70\uC694. \uC18C\uC18D\uACFC
        \uC77C\uB828\uBC88\uD638\uB97C \uB9D0\uC500\uD558\uC2ED\uC2DC\uC624."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[5]
      value: "\uAE30\uC5B5\uB098\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[6]
      value: "\uC2E0\uC6D0 \uBBF8\uD655\uC778\u2026 \uC6D0\uB798\uB294 \uC548 \uB418\uC9C0\uB9CC,
        \uBCF4\uC99D\uC778\uC774 \uC788\uC73C\uB2C8 \uC784\uC2DC \uCD9C\uC785\uC744
        \uD5C8\uAC00\uD558\uC8E0. \uC804 \uBC31\uC774\uC5F0\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[7]
      value: "\uD544\uC694\uD558\uC2DC\uB2E4\uBA74 \uAE30\uC220\uC744 \uB098\uB220
        \uB4DC\uB9AC\uC8E0. \uB2E8, \uB0AD\uBE44\uD558\uBA74 \uB450 \uBC88\uC740
        \uC5C6\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[8]
      value: "\uB458 \uB2E4 \uB9D0\uD22C\uB294 \uC800\uB798\uB3C4 \uC19C\uC528\uB294
        \uD655\uC2E4\uD574. \uBAB8 \uC190\uBCF4\uB294 \uAC74 \uB098\uD55C\uD14C \uC624\uACE0!"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[0]
      value: "\uACE0\uCCA0\uC744 \uC313\uC544 \uB9CC\uB4E0 \uB178\uC810. \uB0AF\uC775\uC740
        \uC5BC\uAD74 \uB458\uC774 \uBD88\uC744 \uD53C\uC6B0\uACE0 \uC788\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[1]
      value: "\uC0B4\uC544 \uC788\uC5C8\uB124? \uC704\uC5D0\uC120 \uB2E4\uB4E4 \uB124\uAC00
        \uCC45\uC774 \uB410\uB2E4\uACE0 \uD558\uB358\uB370."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[2]
      value: "\uCC45\uC774 \uB418\uB294 \uAC83\uC740 \uAC70\uC808\uD588\uC2B5\uB2C8\uB2E4.
        \uB300\uC2E0 \uD30C\uAD34\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[3]
      value: "\uD558, \uADF8\uAC78 \uC8FC\uC778\uC774 \uB0A9\uB4DD\uD574 \uC92C\uC5B4?
        \u2026\uBB50, \uB098\uC060 \uAC74 \uC5C6\uC9C0."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[4]
      value: "\uC601\uBCF5 \uC528\uAC00 \uB2E4\uC2DC \uC870\uB9BD\uD588\uB2E4\uACE0
        \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uC7A0\uC2DC \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4.
        \uC601 \uAF3C\uAF3C\uD568\uC774\uB77C\uACE4 \uC5C6\uB294 \uC0AC\uB78C\uC774\uB2C8."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[5]
      value: "\uBC31\uC774\uC5F0\uC774 \uD5E4\uB124\uC2DC\uC758 \uBAA9 \uB4A4 \uD53C\uBD80
        \uD30C\uCE20 \uC77C\uBD80\uB97C \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4. \uADF8 \uC544\uB798,
        \uBC18\uCBE4 \uAE01\uD600 \uB098\uAC04 \uAC01\uC778\uC774 \uC788\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[6]
      value: "\u2026\uC774 \uAC01\uC778\uC740 \uC9C0\uC6CC\uC84C\uC5B4\uC57C \uD558\uB294\uB370."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[7]
      value: "\uBB34\uC5C7\uC774 \uC801\uD600 \uC788\uC2B5\uB2C8\uAE4C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[8]
      value: "\uB9D0\uC500\uB4DC\uB838\uB4EF, \uAC01\uC778\uC785\uB2C8\uB2E4. ...\uC5B4\uB290
        \uC21C\uAC04 \uACE0\uC704\uC9C1\uC758 \uC548\uB4DC\uB85C\uC774\uB4DC\uB4E4\uC774
        \uC0AC\uB77C\uC9C4\uB2E4 \uD588\uB354\uB2C8..."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[9]
      value: "\uC81C\uAC00 \uACBD\uD638\uD558\uB358 \uBD84\uC758 \uBE44\uC11C\uAC00,
        \uC774\uB7F0 \uACF3\uC5D0 \uBC84\uB824\uC838 \uC788\uC5C8\uAD70\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[10]
      value: "\uADF8\uBD84\uC740 \uB204\uAD6C\uC785\uB2C8\uAE4C. \uC800\uB294 \uAE30\uC5B5\uC774\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[11]
