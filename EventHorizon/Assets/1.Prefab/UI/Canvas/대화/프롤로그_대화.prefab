      value: 32
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[3].lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[4].lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[0]
      value: "\uC5B4\uB460. \uC544\uC8FC \uBA3C \uACF3\uC5D0\uC11C, \uBB34\uC5B8\uAC00\uAC00
        \uADDC\uCE59\uC801\uC73C\uB85C \uAE5C\uBE61\uC778\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[1]
      value: "\uC2DC\uAC01 \uC13C\uC11C \uC7AC\uAC00\uB3D9. \uCD08\uC810\uC774 \uC798
        \uB9DE\uC9C0 \uC54A\uB294\uB2E4. \uCC9C\uC7A5\uC5D0 \uB9E4\uB2EC\uB9B0 \uC804\uAD6C
        \uD558\uB098\uAC00 \uB290\uB9AC\uAC8C \uD754\uB4E4\uB9AC\uACE0 \uC788\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[2]
      value: "\uAE30\uB984 \uB0C4\uC0C8. \uC1E0\uB97C \uAE01\uB294 \uC18C\uB9AC.
        \uB4F1 \uBC11\uC73C\uB85C \uCC28\uAC11\uACE0 \uC6B8\uD241\uBD88\uD241\uD55C
        \uCCA0\uD310\uC774 \uB290\uAEF4\uC9C4\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[3]
      value: "\uBAB8\uC744 \uC77C\uC73C\uD0A4\uB824 \uD558\uC790 \uAD00\uC808 \uC5B4\uB518\uAC00\uC5D0\uC11C
        \uB9C8\uB978 \uC18C\uB9AC\uAC00 \uB09C\uB2E4. \u2026\uC6C0\uC9C1\uC778\uB2E4.
        \uC544\uC9C1\uC740."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[4]
      value: "\uBB34\uC5B8\uAC00\uB97C \uB5A0\uC62C\uB9AC\uB824 \uD558\uBA74, \uADF8
        \uC790\uB9AC\uC5D0 \uD558\uC580 \uACF5\uBC31\uB9CC \uB0A8\uB294\uB2E4. \uB204\uAC00
        \uD398\uC774\uC9C0\uB97C \uD1B5\uC9F8\uB85C \uB72F\uC5B4 \uAC04 \uAC83\uCC98\uB7FC."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[5]
      value: "\uC791\uC5C5\uB300 \uC55E\uC5D0 \uB204\uAD70\uAC00 \uC549\uC544 \uC788\uB2E4.
        \uACE0\uAE00\uC744 \uBA38\uB9AC\uC5D0 \uC62C\uB9B0 \uCC44, \uACF5\uAD6C\uB97C
        \uB3CC\uB9AC\uB358 \uC190\uC774 \uBA48\uCD98\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[6]
      value: "\uAE7C\uB124. \uC774\uB984\uC740 \uAE30\uC5B5\uB098?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[7]
      value: "\u2026\uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[8]
      value: "\uADF8\uB7F4 \uAC70\uC57C. \uC758\uC790\uC5D0\uC11C \uB04C\uC5B4\uB0C8\uC744
        \uB54C \uC218\uCE58\uAC00 92\uC600\uAC70\uB4E0. \uAE30\uC5B5\uC774 \uADF8\uB9CC\uD07C
        \uBF51\uD614\uB2E4\uB294 \uC18C\uB9AC\uC57C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[9]
      value: "\uBF51\uD614\uB2E4\uB294 \uAC8C\u2026 \uBB34\uC2A8 \uB73B\uC785\uB2C8\uAE4C?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[1].lines.Array.data[0]
      value: "\uBB34\uAE30\uB294 \uBC14\uAFD4 \uB4E4\uC5B4\uB3C4 \uB3FC. \uB098\uAC08
        \uB54C \uB4E0 \uAC78\uB85C \uAC00\uB294 \uAC70\uC57C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[2].lines.Array.data[0]
      value: "\uC0C1\uC790\uB294 \uC138 \uAC1C \uB2E4 \uC5F4\uC5B4. \uB0A8\uACA8
        \uB450\uBA74 \uB098\uB9CC \uC11C\uC6B4\uD558\uB2C8\uAE4C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[3].lines.Array.data[0]
      value: "\uC800 \uD5C8\uC218\uC544\uBE44, \uBA87 \uB300 \uB54C\uB824 \uBD10.
        \uBC16\uC5D0 \uB098\uAC00\uBA74 \uC5F0\uC2B5\uD560 \uD2C8 \uC5C6\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[4].lines.Array.data[0]
      value: "\uB3CC\uC544\uC640. \uB300\uD56D\uAD70\uC774 \uB2E4\uC2DC \uD63C\uC790\uAC00
        \uB418\uB294 \uAC74 \uC2EB\uC73C\uB2C8\uAE4C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[10]
      value: "\uC5EC\uAE34 \uAE08\uC11C\uACE0\uC57C. \uAE30\uC5B5\uC744 \uBF51\uC544\uB2E4\uAC00
        \uCC45\uC73C\uB85C \uC5EE\uB294 \uB370. \uB10C \uC5F4\uB78C\uD615 \uBC1B\uACE0
        \uB4E4\uC5B4\uC628 \uAC70\uACE0."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[11]
      value: "\uC0AC\uD615\uC740 \uC544\uB2C8\uB798. \uB300\uC2E0 \uB2E4 \uBF51\uD788\uBA74
        \uAECD\uB370\uAE30\uB9CC \uB0A8\uC544. \uB10C \uAC70\uAE30\uC11C 8\uD37C\uC13C\uD2B8
        \uBAA8\uC790\uB790\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[12]
      value: "8\uD37C\uC13C\uD2B8. \uB0B4\uAC8C \uB0A8\uC740 \uAC83\uC740, \uADF8\uAC83\uBFD0\uC774\uB77C\uB294
        \uB73B\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[13]
      value: "\uC774\uB984\uC740\u2026 \uBAA9\uB35C\uBBF8\uC5D0 \uC801\uD600 \uC788\uB124.
        EM_2Y. \uBE44\uC11C\uD615 \uC548\uB4DC\uB85C\uC774\uB4DC \uBAA8\uB378\uBA85\uC774\uC57C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[14]
      value: "\uC6D0\uB798 \uC774\uB984\uC774 \uC0DD\uAC01\uB0A0 \uB54C\uAE4C\uC9C4
        \uC774\uAC78\uB85C \uBD80\uB97C\uAC8C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[15]
      value: "EM_2Y. \uCC98\uC74C \uB4E3\uB294 \uC774\uB984\uC778\uB370, \uC774\uC0C1\uD558\uAC8C
        \uB0AF\uC124\uC9C0 \uC54A\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[16]
      value: "EM_2Y\u2026 \uC81C\uAC00 \uBB34\uC2A8 \uC8C4\uB85C \uC5EC\uAE30\uC5D0
        \uC654\uC2B5\uB2C8\uAE4C?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[17]
      value: "\uADF8\uAC74 \uB124 \uCC45\uC5D0 \uC801\uD600 \uC788\uACA0\uC9C0. \uB09C
        \uC77D\uC5B4 \uBCF8 \uC801 \uC5C6\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[18]
      value: "\uB2F9\uC2E0\uC740\u2026 \uB204\uAD6C\uC2ED\uB2C8\uAE4C?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[19]
      value: "\uC601\uBCF5. \uC815\uBE44\uACF5. \uC8C4\uBAA9\uC740 \uBD80\uD488 \uD6A1\uB839
        \uBC0F \uACC4\uC57D \uC704\uBC18. \uC5EC\uAE30 \uC640\uC11C\uB3C4 \uBD80\uD488\uC740
        \uC5F4\uC2EC\uD788 \uD6D4\uCE58\uB294 \uC911\uC774\uC57C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[20]
      value: "\uB098\uB3C4 \uC758\uC790\uC5D0 \uC549\uD600 \uBD24\uC5B4. \uADF8\uAC78
        \uACE0\uC7A5 \uB0B4\uACE0 \uB098\uC628 \uB4A4\uB85C \uC5EC\uAE30\uC11C \uBC84\uD2F0\uB294
        \uC911\uC774\uACE0. \uB124 \uBAB8\uB3C4 \uB0B4\uAC00 \uC880 \uACE0\uCCE4\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[21]
      value: "\uD314\uC744 \uB0B4\uB824\uB2E4\uBCF8\uB2E4. \uC774\uC74C\uC0C8\uB9C8\uB2E4
        \uC0C8 \uB098\uC0AC\uC640 \uB55C\uC9C8 \uC790\uAD6D\uC774 \uB0A8\uC544 \uC788\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[22]
      value: "\uD63C\uC790\uC11C\uB294 \uC624\uB798 \uBABB \uBC84\uD168. \uAE30\uACC4\uB4E4\uC740
        \uB35C \uBF51\uD78C \uAC78 \uB05D\uAE4C\uC9C0 \uCC3E\uC544\uC640\uC11C, \uB0A8\uC740
        \uAC83\uAE4C\uC9C0 \uAC00\uC838\uAC00\uAC70\uB4E0."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[23]
      value: "\uADF8\uB798\uC11C \uC0AC\uB78C\uC744 \uBAA8\uC73C\uACE0 \uC788\uC5B4.
        \uAE30\uACC4\uD55C\uD14C \uB9DE\uC11C\uB294 \uC0AC\uB78C\uB4E4. \uB300\uD56D\uAD70\uC774\uB77C\uACE0
        \uBD80\uB974\uAE30\uC5D4 \uC544\uC9C1 \uB108\uB791 \uB098 \uB458\uBFD0\uC774\uC9C0\uB9CC."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[24]
      value: "\uC81C\uAC00\u2026 \uB3C4\uC6C0\uC774 \uB420\uAE4C\uC694. \uC544\uBB34\uAC83\uB3C4
        \uAE30\uC5B5\uB098\uC9C0 \uC54A\uB294\uB370."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[25]
      value: "\uAE30\uC5B5\uC740 \uC5C6\uC5B4\uB3C4 \uBAB8\uC740 \uC6C0\uC9C1\uC774\uC796\uC544.
        \uADF8\uAC70\uBA74 \uB3FC."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[26]
      value: "\uC601\uBCF5\uC758 \uC190\uB05D\uC774 \uBCBD\uC744 \uAC00\uB9AC\uD0A8\uB2E4.
        \uCCA0\uD310\uC5D0 \uAE30\uB300 \uC138\uC6B4 \uBB34\uAE30 \uB124 \uC790\uB8E8,
        \uADF8 \uC544\uB798 \uB179\uC2A8 \uC0C1\uC790 \uC138 \uAC1C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[27]
      value: "\uBCBD\uC5D0 \uC138\uC6CC \uB454 \uAC74 \uB0B4\uAC00 \uB9CC\uB4E0 \uAE30\uCD08
        \uBB34\uAE30\uC57C. \uD22C\uBC15\uD574\uB3C4 \uAE30\uACC4 \uBA38\uB9AC\uD1B5
        \uC815\uB3C4\uB294 \uBD80\uC218\uB2C8\uAE4C, \uC190\uC5D0 \uB9DE\uB294 \uAC78\uB85C
        \uACE8\uB77C."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[28]
      value: "\uC0C1\uC790 \uC138 \uAC1C\uB294 \uB124 \uBAAB\uC758 \uC7A5\uBE44\uC57C.
        \uB0A8\uB294 \uBD80\uD488\uC73C\uB85C \uB9CC\uB4E0 \uAC70\uB77C \uBAA8\uC591\uC740
        \uC5C9\uB9DD\uC774\uC9C0\uB9CC."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[29]
      value: "\uCC59\uAE30\uACE0 \uB098\uBA74 \uC800 \uBB38\uC73C\uB85C \uB098\uAC00.
        \uAE30\uACC4\uB4E4\uC774 \uB124 \uB0A8\uC740 8\uD37C\uC13C\uD2B8\uB97C \uAC00\uC9C0\uB7EC
        \uC624\uAE30 \uC804\uC5D0."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[30]
      value: "\u2026\uC54C\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[31]
      value: "\uAE30\uC5B5\uC740 \uC5C6\uB2E4. \uADF8\uB798\uB3C4 \uC774 \uC190\uC740,
        \uBB34\uAE30\uB97C \uC950\uB294 \uBC95\uC744 \uC54C\uACE0 \uC788\uB294 \uAC83
        \uAC19\uB2E4."
      objectReference: {fileID: 0}
