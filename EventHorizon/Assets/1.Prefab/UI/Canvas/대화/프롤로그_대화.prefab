      value: idle2
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[3].conditionKey
      value: idle3
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[4].conditionKey
      value: idle4
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[0]
      value: "\uc2dc\uac01 \uc13c\uc11c \uc7ac\uac00\ub3d9. \uae30\ub984 \ub0c4\uc0c8, \ucc28\uac00\uc6b4 \ucca0\ud310. \u2026\uc6c0\uc9c1\uc778\ub2e4. \uc544\uc9c1\uc740."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[1]
      value: "\ubb34\uc5b8\uac00\ub97c \ub5a0\uc62c\ub9ac\ub824 \ud558\uba74, \ud558\uc580 \uacf5\ubc31\ub9cc \ub0a8\ub294\ub2e4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[2]
      value: "\uc624, \uc791\ub3d9\ud55c\ub2e4! \uc548\ub155! \uc5ec\uae34 \uae08\uc11c\uace0\uc57c. \uae30\uc5b5\uc744 \ubf51\uc544\ub2e4 \ucc45\uc73c\ub85c \uc5ee\ub294 \uacf3."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[3]
      value: "\ub10c 92\ud37c\uc13c\ud2b8\uac00 \ubf51\ud614\uc5b4. \ub0a8\uc740 \uac74 8\ud37c\uc13c\ud2b8\ubfd0\uc774\uc57c."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[4]
      value: "\ubaa9\ub35c\ubbf8\uc5d0 EM_2Y\ub77c\uace0 \uc801\ud600 \uc788\ub124. \ub2f9\ubd84\uac04 \uadf8\ub807\uac8c \ubd80\ub97c\uac8c."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[5]
      value: "\u2026\ub2f9\uc2e0\uc740 \ub204\uad6c\uc2ed\ub2c8\uae4c?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[6]
      value: "\uc601\ubcf5. \uc815\ube44\uacf5\uc774\uc57c. \ub124 \ubab8\ub3c4 \ub0b4\uac00 \uace0\ucce4\uc5b4."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[7]
      value: "\ub098\ub3c4 \ub108\ucc98\ub7fc \uae30\uc5b5\uc744 \ubf51\ud790 \ubed4\ud588\uac70\ub4e0. \uc624\ub958\ub97c \ubbf8\ub9ac \ub9cc\ub4e4\uc5b4 \ub450\uae38 \uc798\ud588\uc9c0 \ubb50\uc57c."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[8]
      value: "\ub098\ucc98\ub7fc \uae30\uc5b5\uc774 \ubaa8\ub450 \ubf51\ud788\uc9c0 \uc54a\uc740 \uc874\uc7ac\ub4e4\uc740 \uc800 \ub3c4\uc11c\uad00 \uc548\uc5d0 \uc788\ub294 \uae30\uacc4\ub4e4\ud55c\ud14c \ucad3\uaca8."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[9]
      value: "\uadf8\ub798\uc11c \ub300\ud56d\uad70\uc744 \ub9cc\ub4e4 \uac70\uc57c. \uc544\uc9c1\uc740 \ub108\ub791 \ub098, \ub458\ubfd0\uc774\uae34 \ud558\uc9c0\ub9cc?"
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[10]
      value: "\ubcbd\uc5d0 \uc138\uc6cc \ub454 \ubb34\uae30 \uc911 \uc190\uc5d0 \ub9de\ub294 \uac78 \uace0\ub974\uace0, \uc900\ube44\ud574 \ub454 \uc0c1\uc790 \uc138 \uac1c\ub3c4 \ucc59\uaca8. \ub0b4\uac00 \ub9cc\ub4e0 \uac83\ub4e4\uc774 \uaf64 \uc788\uc744 \uac70\uc57c."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[11]
      value: "\uadf8\ub9ac\uace0 \uc800 \ubb38\uc73c\ub85c \ub098\uac00. \uae30\uacc4\ub4e4\uc774 \ub124 \ub0a8\uc740 8\ud37c\uc13c\ud2b8\ub97c \uac00\uc9c0\ub7ec \uc624\uae30 \uc804\uc5d0."
      objectReference: {fileID: 0}
    - target: {fileID: 5522553732493958236, guid: e6b93bc8075e21541a44eda51b345741, type: 3}
      propertyPath: dialogueSets.Array.data[0].lines.Array.data[12]
      value: "\u2026\uc54c\uaca0\uc2b5\ub2c8\ub2e4."
      objectReference: {fileID: 0}
