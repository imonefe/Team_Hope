    moreGates: []
    startZone: {fileID: 0}
  - title: "\uB300\uC2DC \xB7 \uB354\uBE14 \uB300\uC2DC"
    guide: "{Dash} \uB204\uB974\uBA74 \uD655 \uD280\uC5B4 \uB098\uAC00. \uD280\uC5B4
      \uB098\uAC00\uB294 \uB3D9\uC548\uC5D4 \uC801 \uACF5\uACA9\uB3C4 \uC548 \uB9DE\uC544.
      \uAD6C\uB369\uC774\uAC00 \uB113\uC73C\uBA74 {Dash} \uB450 \uBC88 \uC774\uC5B4\uC11C!"
    guide2: 
    condition: 3
