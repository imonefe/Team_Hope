  steps:
  - title: "\uC810\uD504 \xB7 \uB354\uBE14 \uC810\uD504"
    guide: "\uB4E4\uB824? \uC88B\uC544, \uC5F0\uACB0\uB410\uB124. \u2190 \u2192 \uB85C
      \uAC77\uACE0 {Jump} \uB85C \uB6F0\uC5B4. \uBCBD\uC774 \uB192\uC73C\uBA74 \uACF5\uC911\uC5D0\uC11C
      {Jump} \uD55C \uBC88 \uB354."
    guide2: 
    condition: 1
    gate: {fileID: 0}
    checkpoint: {fileID: 0}
    reachZone: {fileID: 0}
    dummy: {fileID: 0}
    damageNeeded: 50
