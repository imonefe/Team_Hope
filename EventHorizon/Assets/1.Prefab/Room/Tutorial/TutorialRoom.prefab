--- !u!114 &6032895608797074247
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8880233381792504078}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe03109d56bb33a4ea9530546b2691ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  steps:
  - title: "\uC810\uD504 \xB7 \uB354\uBE14 \uC810\uD504"
    guide: "\u2190 \u2192 \uB85C \uAC77\uACE0 {Jump} \uB85C \uB6F0\uC5B4. \uBCBD\uC774
      \uB192\uC73C\uBA74 \uACF5\uC911\uC5D0\uC11C {Jump} \uD55C \uBC88 \uB354."
    guide2: 
    guide3: 
    condition: 1
    gate: {fileID: 0}
    checkpoint: {fileID: 0}
    reachZone: {fileID: 0}
    dummy: {fileID: 0}
    damageNeeded: 50
    hitsNeeded: 3
    box: {fileID: 0}
    fillPauseGauge: 0
    grantSkill: {fileID: 0}
    moreGates: []
    startZone: {fileID: 0}
    passZone: {fileID: 7138974104417096111}
    preLines:
    - "\u2026\uC5F0\uACB0\uB410\uB2E4. \uB4E4\uB824? \uB4E4\uB9AC\uBA74 \uC6C0\uC9C1\uC5EC
      \uBD10."
    - "\uB2E4\uB9AC\uBD80\uD130. \uCC9C\uCC9C\uD788. \uB108 \uC9C0\uAE08 \uB9C9 \uCF1C\uC9C4
      \uAC70\uB098 \uB2E4\uB984\uC5C6\uAC70\uB4E0."
    keyHint: "\u2190 \u2192 \uC774\uB3D9 \xB7 {Jump} \uC810\uD504 \xB7 \uACF5\uC911\uC5D0\uC11C
      {Jump} \uD55C \uBC88 \uB354 = \uB354\uBE14 \uC810\uD504"
  - title: "\uB300\uC2DC \xB7 \uB354\uBE14 \uB300\uC2DC"
    guide: "{Dash} \uB204\uB974\uBA74 \uD655 \uD280\uC5B4 \uB098\uAC00. \uD280\uC5B4
      \uB098\uAC00\uB294 \uB3D9\uC548\uC5D4 \uC801 \uACF5\uACA9\uB3C4 \uC548 \uB9DE\uC544.
      \uAD6C\uB369\uC774\uAC00 \uB113\uC73C\uBA74 {Dash} \uB450 \uBC88 \uC774\uC5B4\uC11C!"
    guide2: 
    guide3: 
    condition: 3
    gate: {fileID: 45652684361262706}
    checkpoint: {fileID: 0}
    reachZone: {fileID: 0}
    dummy: {fileID: 0}
    damageNeeded: 50
    hitsNeeded: 3
    box: {fileID: 0}
    fillPauseGauge: 0
    grantSkill: {fileID: 0}
    moreGates: []
    startZone: {fileID: 9016111903987752935}
    passZone: {fileID: 7131321108144680926}
    preLines: []
    keyHint: "{Dash} \uB300\uC2DC (\uB300\uC2DC \uC911 \uBB34\uC801) \xB7 {Dash}
      \uB450 \uBC88 \uC5F0\uC18D = \uB354\uBE14 \uB300\uC2DC"
  - title: "\uBC1C\uD310 \uB0B4\uB824\uAC00\uAE30"
    guide: "\uBC1C\uD310 \uC704\uC5D0\uC11C \u2193 \uB204\uB978 \uCC44\uB85C {Jump}.
      \uC544\uB798\uB85C \uC465 \uB0B4\uB824\uAC08 \uC218 \uC788\uC5B4."
    guide2: 
    guide3: 
    condition: 4
    gate: {fileID: 0}
    checkpoint: {fileID: 3836342216976003658}
    reachZone: {fileID: 6793867041267863395}
    dummy: {fileID: 0}
    damageNeeded: 50
    hitsNeeded: 3
    box: {fileID: 0}
    fillPauseGauge: 0
    grantSkill: {fileID: 0}
    moreGates: []
    startZone: {fileID: 5345442223053904111}
    passZone: {fileID: 0}
    preLines: []
    keyHint: "\uBC1C\uD310 \uC704\uC5D0\uC11C \u2193 + {Jump} = \uC544\uB798\uB85C
      \uB0B4\uB824\uAC00\uAE30"
  - title: "\uacf5\uaca9 \u00b7 \uc2a4\ud0ac \u00b7 \ubb34\uae30 \u00b7 \ud37c\uc988 \u00b7 \uc99d\uac15 \u00b7 \uc778\ubca4\ud1a0\ub9ac"
    guide: "{Attack} \uB85C \uC800 \uD5C8\uC218\uC544\uBE44 \uC138 \uBC88\uB9CC \uB450\uB4E4\uACA8
      \uBD10. \uC544\uD504\uC9C0 \uC54A\uC73C\uB2C8\uAE4C \uB9C8\uC74C\uAECF."
    guide2: "\uC2A4\uD0AC \uD558\uB098 \uB123\uC5B4 \uB480\uC5B4. {Skill2} \uB85C
      \uC368 \uBD10."
    guide3: "\uC88B\uC544. \u2026\uC5B4\uB77C, \uC804\uD22C\uC6A9 \uC548\uB4DC\uB85C\uC774\uB4DC\uB3C4
      \uC544\uB2CC\uB370 \uC774\uB7F0 \uAE30\uB2A5\uAE4C\uC9C0 \uB2EC\uB824 \uC788\uB124?
      \uAC8C\uC774\uC9C0 \uCC44\uC6CC \uB1A8\uC73C\uB2C8\uAE4C {Pause} \uB20C\uB7EC
      \uBD10. \uC138\uC0C1\uC774 \uBA48\uCD9C \uAC70\uC57C."
    guideSwap: "\ubb34\uae30\uac00 \ud558\ub098\ubfd0\uc778 \uc904 \uc54c\uc558\uc9c0? {WeaponSwap} \ub85c \ubc14\uafd4 \ubd10. \uac80, \uac74\ud2c0\ub9bf, \ub9dd\uce58."
    guidePaused: "\uc774\uac8c \ud37c\uc988\uc57c. \uc138\uc0c1\uc740 \uac70\uc758 \uba48\ucd94\uace0 \ub108\ub9cc \uc6c0\uc9c1\uc5ec. \uc801\ub3c4, \ub0a0\uc544\uc624\ub358 \ud0c4\ub3c4 \uadf8\ub300\ub85c \uc11c \uc788\uc5b4. \uc774 \ud2c8\uc5d0 \uc790\ub9ac \uc7a1\uace0 \ub54c\ub824. {Pause} \ub97c \ub2e4\uc2dc \ub204\ub974\uac70\ub098 \uc2dc\uac04\uc774 \ub2e4 \ub418\uba74 \ud480\ub824."
    guideAugment: "\uc601\ubcf5\uc774 \uc8fc\uc6b4 \ubd80\ud488 \uc138 \uac1c\uc57c. \ud558\ub098 \uace8\ub77c\uc11c \ub07c\uc6cc \ubd10. \u2190 \u2192 \ub85c \ubcf4\uace0 Space \ub85c \uacb0\uc815. \uc5f0\uc2b5\uc6a9\uc774\ub77c \ubc16\uc5d0 \ub098\uac00\uba74 \ube60\uc838."
    guideInventory: "\ubd99\uc5c8\uc5b4. {Inventory} \ub85c \uac00\ubc29 \uc5f4\uc5b4 \ubd10. \ubc29\uae08 \ub07c\uc6b4 \ubd80\ud488\uc774\ub791 \uc7ac\ud654\ub294 \uc5ec\uae30\uc11c \ud655\uc778\ud574."
    condition: 15
    gate: {fileID: 0}
    checkpoint: {fileID: 4974510857775946637}
    reachZone: {fileID: 0}
    dummy: {fileID: 7381682755882637222}
    damageNeeded: 50
    hitsNeeded: 3
    box: {fileID: 0}
    fillPauseGauge: 1
    grantSkill: {fileID: 309512161303808426, guid: 90ca78251e437d14e9b75f3787e2ff2c, type: 3}
    moreGates:
    - {fileID: 0}
    startZone: {fileID: 1046995400016461043}
    passZone: {fileID: 0}
    preLines:
    - "\uBAB8\uC774 \uAE30\uC5B5 \uBABB \uD574\uB3C4 \uD63C\uC790 \uAE30\uC5B5\uD558\uB294
      \uAC8C \uC788\uC5B4. \uADF8\uAC78 \uBBFF\uC5B4."
    keyHint: "{Attack} \uacf5\uaca9 \u00b7 {Skill2} \uc2a4\ud0ac \u00b7 {WeaponSwap} \ubb34\uae30 \uad50\uccb4 \u00b7 {Pause} \ud37c\uc988 \u00b7 \u2190 \u2192 Space \uc99d\uac15 \uace0\ub974\uae30 \u00b7 {Inventory} \uc778\ubca4\ud1a0\ub9ac"
  titleText: {fileID: 5319361892942684638}
  guideText: {fileID: 3635825154361112920}
  doneTitle: "\uD29C\uD1A0\uB9AC\uC5BC \uC644\uB8CC"
  doneGuide: "\uD569\uACA9. \uC2DC\uBBAC\uB808\uC774\uC158\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC57C.
    \u2026\uC774\uC81C \uC9C4\uC9DC\uB85C \uAE68\uC6B8\uAC8C."
  doneLines:
  - "\uC88B\uC544, \uC774 \uC815\uB3C4\uBA74 \uC0B4\uC544\uB0A8\uACA0\uB2E4."
  - "\uAE08\uBC29 \uBAB8\uCCB4\uC5D0 \uC5F0\uACB0\uD574 \uC904\uAC8C. \uC804\uC6D0\uC774
    \uCF1C\uC9C0\uBA74 \uC778\uC0AC\uBD80\uD130 \uD558\uC790\uACE0. \uC5BC\uAD74\uC740\u2026
    \uAC00\uC11C \uBCF4\uBA74 \uC54C \uAC70\uC57C."
  storyLineSeconds: 3
  keyHintColor: {r: 0.56, g: 0.72, b: 0.87, a: 1}
  keyHintSizePercent: 85
  speakerName: ???
  hideSpeakerFace: 1
  guideTopCenter: 1
  lobbyRoom: {fileID: 8548028022454420013, guid: 085831358d7842c585da074824a8821b, type: 3}
