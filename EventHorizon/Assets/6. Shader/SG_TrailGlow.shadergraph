{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "5d839f52a9f14bbd960c0b42ca54d14c",
    "m_Title": "가짜 글로우",
    "m_Content": "_GlowTex 알파 = 번짐 모양 (가로: 꼬리→칼끝, 세로: 안쪽→바깥, 0.25~0.75 = 원래 검흔 자리).\nGlowColor(HDR) x Intensity x 알파 를 Additive 로 더함.\nIntensity 를 애니메이션 클립에서 키를 찍어 검흔과 같이 사라지게.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1000.0,
        "y": -320.0,
        "width": 360.0,
        "height": 180.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

