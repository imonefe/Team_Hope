{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "bcf01e03b3904ee3a6e17c7d9232953c",
    "m_Title": "1. \uc77c\ub801\uc784",
    "m_Content": "\ub178\uc774\uc988 \ud14d\uc2a4\ucc98\ub97c \uc2dc\uac04\uc5d0 \ub530\ub77c \ud758\ub824\uc11c(NoiseSpeed) \ud53d\uc140\ub9c8\ub2e4 \ub2e4\ub978 \ubc29\ud5a5\uc73c\ub85c \ubc00\uc5b4\ub0c4.\nWobble = \uc77c\ub801\uc784 \ube44\uc728",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2300.0,
        "y": -250.0,
        "width": 300.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3b047196df9448918c33442223b35b40",
    "m_Title": "2. \ubcfc\ub85d\ub80c\uc988",
    "m_Content": "UV - 0.5 = \uc2a4\ud504\ub77c\uc774\ud2b8 \uc911\uc2ec\uc5d0\uc11c \ubc14\uae65\uc73c\ub85c \ud5a5\ud558\ub294 \ubc29\ud5a5.\nBulge + : \uac00\uc6b4\ub370\uac00 \ubd80\ud480\uc5b4 \ubcf4\uc784 / - : \uc624\ubaa9",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1700.0,
        "y": 750.0,
        "width": 300.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "7fb13647da1c40c7ab634cca280f882c",
    "m_Title": "3. \ud654\uba74 \ud14d\uc2a4\ucc98",
    "m_Content": "_CameraSortingLayerTexture = \uc9c0\uae08\uae4c\uc9c0 \uadf8\ub824\uc9c4 \ud654\uba74.\nScreen Position + \uc65c\uace1\ub7c9 \uc73c\ub85c \ube44\ud2c0\uc5b4\uc11c \ub2e4\uc2dc \uadf8\ub9bc.\n\u203b Reference \uc774\ub984\uc774 \uc815\ud655\ud788 \uc774\uac83\uc774\uc5b4\uc57c \ud568, Exposed \ub054",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -650.0,
        "y": -330.0,
        "width": 300.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "401f0b26dbad4f95bd361be2d0afa7b1",
    "m_Title": "4. \ub9c8\uc2a4\ud06c",
    "m_Content": "_MainTex = \uc2a4\ud504\ub77c\uc774\ud2b8 \ub80c\ub354\ub7ec\uc758 \uc2a4\ud504\ub77c\uc774\ud2b8.\n\uc54c\ud30c\uac00 \uc788\ub294 \uacf3\ub9cc \uc65c\uace1 + Alpha \ucd9c\ub825.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2000.0,
        "y": 850.0,
        "width": 300.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

