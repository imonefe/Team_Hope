{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "bcf01e03b3904ee3a6e17c7d9232953c",
    "m_Title": "1. 일렁임",
    "m_Content": "노이즈 UV = 월드 좌표(Position World의 XY). 오브젝트/파티클마다 다른 무늬가 걸림.\nNoiseTiling = 월드 1유닛당 반복 수(작을수록 큰 무늬), NoiseSpeed = 흐르는 방향/속도.\nWobble = 일렁임 비율",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2300.0,
        "y": -250.0,
        "width": 300.0,
        "height": 160.0
