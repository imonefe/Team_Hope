{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ed500bf1b1784deb80b68f2f75d0a17d",
    "m_Title": "0. 글리치",
    "m_Content": "GlitchTex를 (가로 0, 세로 GlitchTiling)로 읽으면 가로 띠, 시간으로 옆으로 흘리면 프레임마다 띠가 바뀜.\nR-0.5 = 밀리는 양, G = 이 띠가 튀는지, ×GlitchStrength ×GlitchDir(1,0) → 가로로만 밀기.\n이 값을 모든 UV에 더해서 이펙트 전체가 띠 단위로 어긋남.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2600.0,
        "y": -1550.0,
        "width": 420.0,
        "height": 200.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

