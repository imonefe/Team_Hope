{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "2c985517cabc42db933c00aad7729790",
    "m_Title": "글리치 (화면)",
    "m_Content": "균열 셰이더와 같은 GlitchTex 띠를 충격파 사각형 전체에 적용 → 타원 밖까지 화면이 띠 단위로 밀림.\nGlitchTiling/GlitchBase는 균열 사각형과 띠 위치가 맞도록 높이 비율로 맞춤. 가로·세로 따로 (0.25-x²), (0.25-y²)로 감쇠 → 타원이 아니라 사각형 전체에 퍼지고 가장자리만 부드럽게 사라짐.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1100.0,
        "y": -1700.0,
        "width": 460.0,
        "height": 150.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

