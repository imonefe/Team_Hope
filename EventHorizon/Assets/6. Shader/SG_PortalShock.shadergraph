{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ef5d698d7bed4b3db4935ccd36ddec86",
    "m_Title": "사용법",
    "m_Content": "큰 사각형(스프라이트)에 붙이고 ScreenDistortSource 컴포넌트 필요.\nShockRadius를 빠르게 키웠다가 느리게(폭발 감속), ShockStrength·Wobble을 줄여 마무리.\nInnerCut 안쪽(구멍)은 제외, 사각형 가장자리는 부드럽게 사라짐.\n색은 넣지 않음: 일그러뜨린 화면 그대로만 출력 = 순수 왜곡.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 2100.0,
        "y": -700.0,
        "width": 420.0,
        "height": 170.0
    },
