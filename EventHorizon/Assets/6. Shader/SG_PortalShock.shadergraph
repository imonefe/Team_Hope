{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "221225f73ca54f3a8b319549fbf6ce34",
    "m_Title": "울렁임 감쇠",
    "m_Content": "(R²-r²)/(0.6R²) → 중심은 울렁임 그대로, 고리에 가까워질수록 0. 고리 안팎 차이가 줄어 타원 경계가 덜 보임.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 600.0,
        "y": 1900.0,
        "width": 400.0,
        "height": 110.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f10c8e0721514675a743ec276d31bfd6",
    "m_Title": "일렁임",
    "m_Content": "ShockTex G,B = 흐르는 노이즈. 고리 세기를 노이즈로 들쑥날쑥하게 하고(Wobble 없이도), Wobble을 올리면 일대 전체가 노이즈로 울렁거림.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1400.0,
        "y": 700.0,
        "width": 420.0,
        "height": 150.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

