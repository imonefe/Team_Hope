{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "429513376b9f49489875bfa30d3aae76",
    "m_Title": "파형",
    "m_Content": "(r-R)/ShockWidth 를 -1~1 → ShockTex R(파형 그래프)에서 읽음.\n바깥 앞쪽이 가장 세게 밀고, 안쪽으로 출렁임이 줄어드는 물결.\nShockWidth = 물결 두께.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
