{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4a1d78b28b9443d5b3b65cead603d21b",
    "m_Title": "예고선 WARNING 띠",
    "m_Content": "T_WarningText (경고 박스 아래쪽 글자 띠)만 따로 쓰는 셰이더. LineRenderer(Texture Mode = Tile)에 붙임.\nUV = UV × Tiling + Offset + Time × Scroll → 글자 띠가 선을 따라 흘러감.\nTiling.x = 1 / (선 굵기 × 8) 을 스크립트(ArcherMidBoss)가 넣어 줌 → 글자 비율 유지.\n왼쪽으로 가는 선은 Tiling 을 (-, -) 로 뒤집어 글자가 거꾸로 보이지 않게 함.\n색 = 텍스처 × TextColor (경고 박스 글자색과 같은 값).",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1300.0,
        "y": -450.0,
        "width": 560.0,
        "height": 170.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

