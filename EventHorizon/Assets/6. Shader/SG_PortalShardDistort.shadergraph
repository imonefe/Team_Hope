{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "cbc590b6e5204051b7e19ef855a614d2",
    "m_Title": "유리 조각 칸",
    "m_Content": "T_PortalShard: 금 선을 따라 씨앗을 찍고, 씨앗마다 금의 양쪽을 다른 조각으로 나눔 → 금을 경계로 칸칸이 다른 방향으로 밀림.\nR,G = 밀리는 방향(0.5=0) / B = 그 칸 옆 금이 자라는 순서(마스크 G와 같은 값).\nCrackReveal > B 인 칸만 켜짐 → 금이 지나가면 그 옆 유리부터 깨짐.\nHoleTex(마스크) B < HoleOpen×InnerEdge 인 열린 구멍 안은 꺼짐.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1900.0,
        "y": -1450.0,
        "width": 480.0,
        "height": 220.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

