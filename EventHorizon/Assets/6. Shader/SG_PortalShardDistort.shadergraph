{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "aea0cff32a324fd0963af0be8a5d54c1",
    "m_Title": "충격파",
    "m_Content": "타원 거리²(=(UV-0.5)×ShockAspect 의 x²+y²)와 ShockRadius²의 차이로 고리를 만듦: 1-((r²-R²)/ShockWidth)² 를 Saturate.\n고리에서만 바깥 방향으로 화면을 밀어 일렁임. 구멍 안(HoleTex B < InnerEdge)은 제외.\nShockRadius를 키우면 퍼져 나감.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1400.0,
        "y": 870.0,
        "width": 440.0,
        "height": 190.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

