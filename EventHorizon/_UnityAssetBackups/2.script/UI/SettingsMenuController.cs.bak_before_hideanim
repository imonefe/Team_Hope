using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;

/// <summary>
/// 직접 만드신 SettingsCanvas(contnow / restart / contnow (2) 버튼)에 붙이는 컨트롤러.
///
/// SettingsCanvas는 평소 비활성화 상태로 있다가 GameMenuWatcher가 ESC를 감지해서
/// SetActive(true)로 켜준다. 이 스크립트는 그 다음부터의 동작(타임스케일 정지,
/// 전투 UI 가리기, 버튼 클릭 처리, ESC로 닫기)을 전담한다.
///
/// OnEnable/OnDisable을 이용해서 캔버스가 켜지고 꺼지는 것만으로 자동으로
/// Time.timeScale과 CombatUIGate가 맞춰지도록 했다 — GameMenuWatcher가
/// 이 스크립트의 존재를 몰라도 되게 하기 위함.
/// </summary>
public class SettingsMenuController : MonoBehaviour
{
    [Header("버튼")]
    [Tooltip("contnow — 계속하기")]
    public Button continueButton;
    [Tooltip("restart — 처음부터 다시시작")]
    public Button restartButton;
    [Tooltip("contnow (2) — 세 번째 버튼 (용도는 아직 미정, OnThirdButton()에서 원하는 동작으로 채우면 됨)")]
    public Button thirdButton;

    void Awake()
    {
        if (continueButton != null) continueButton.onClick.AddListener(Resume);
        if (restartButton != null) restartButton.onClick.AddListener(RestartGame);
        if (thirdButton != null) thirdButton.onClick.AddListener(OnThirdButton);

        // 버튼 호버/클릭 연출
        UIButtonJuice.Attach(continueButton);
        UIButtonJuice.Attach(restartButton);
        UIButtonJuice.Attach(thirdButton);

        // 이 캔버스 자체가 열고 닫히는 패널이므로(OnEnable/OnDisable로 타임스케일 제어),
        // 켜질 때마다 등장 애니메이션이 자동 재생되도록 여기 직접 붙인다.
        if (GetComponent<UIPanelAnimator>() == null)
            gameObject.AddComponent<UIPanelAnimator>();
    }

    // 캔버스가 켜질 때마다(=메뉴가 열릴 때마다) 자동으로 게임을 멈추고 전투 UI를 가림
    void OnEnable()
    {
        Time.timeScale = 0f;
        CombatUIGate.Block();
    }

    // 캔버스가 꺼질 때마다(=메뉴가 닫힐 때마다) 자동으로 원복
    void OnDisable()
    {
        Time.timeScale = 1f;
        CombatUIGate.Unblock();
    }

    void Update()
    {
        if (Input.GetKeyDown(KeyCode.Escape))
            Resume();
    }

    public void Resume()
    {
        gameObject.SetActive(false); // OnDisable에서 timeScale/CombatUIGate 자동 복구됨
    }

    public void RestartGame()
    {
        // 씬이 넘어가기 전에 명시적으로 원복 — Time.timeScale은 씬을 새로 불러와도
        // 자동으로 리셋되지 않는 전역 상태라서 반드시 여기서 1로 되돌려줘야 한다.
        Time.timeScale = 1f;
        CombatUIGate.Unblock();
        SceneManager.LoadScene(SceneManager.GetActiveScene().buildIndex);
    }

    // TODO: 세 번째 버튼(contnow (2))의 실제 동작을 여기에 채워주세요.
    void OnThirdButton()
    {
        Debug.Log("[SettingsMenuController] 세 번째 버튼 클릭 — 아직 동작이 정해지지 않았습니다.");
    }
}
