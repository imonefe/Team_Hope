using UnityEngine;
using UnityEngine.UI;
using DG.Tweening;

// 보스룸(Room_Boss)에 있는 HP 캔버스를 보스의 Stats.OnHpChanged에 연결해서
// 체력이 줄어들 때마다 Slider 값을 DOTween으로 애니메이션한다. 플레이어 체력바(HpUI.cs)와 같은 방식.
// 보스가 이 오브젝트보다 늦게(방 진입 트리거 이후) 스폰되는 경우를 대비해서
// 보스를 찾을 때까지 주기적으로 재시도한다.
public class BossHpUI : MonoBehaviour
{
    public Slider hpSlider;

    [Header("DOTween 트윈 설정")]
    [Tooltip("체력이 변할 때 슬라이더가 새 값까지 부드럽게 움직이는 데 걸리는 시간(초)")]
    public float tweenDuration = 0.35f;
    public Ease tweenEase = Ease.OutQuad;

    [Tooltip("보스를 찾는 재시도 간격(초)")]
    public float findRetryInterval = 0.5f;

    [Header("데미지 잔상 바 (선택)")]
    [Tooltip("체력바의 Fill Area 안에 있는 보조 Image. 데미지를 입으면 잠깐 그대로 남아있다가 " +
             "천천히 새 체력 값까지 줄어들어서, 방금 깎인 양을 잔상처럼 보여준다. 비워두면 이 기능은 꺼짐.")]
    public Image trailFillImage;
    [Tooltip("잔상 바 색상. 흰색/빨간색 등 원하는 색으로 자유롭게 변경 가능")]
    public Color trailColor = Color.white;
    [Tooltip("데미지를 입은 뒤 잔상 바가 줄어들기 시작하기까지 대기하는 시간(초)")]
    public float trailDelay = 0.2f;
    [Tooltip("잔상 바가 새 체력 값까지 줄어드는 데 걸리는 시간(초)")]
    public float trailDuration = 0.5f;

    Stats bossStats;
    BossController bossRef;

    // 데미지로 잔상 바가 "천천히 따라 내려가는 중"인 동안에는 true — 이 동안엔 Update()가
    // 잔상 바를 건드리지 않는다(트윈 진행을 방해하지 않기 위해).
    bool trailCatchingUp;

    void Awake()
    {
        // 인스펙터에서 따로 연결 안 해놔도 같은 오브젝트의 Slider를 자동으로 사용 —
        // 씬/프리팹 저장 과정에서 필드 연결이 날아가는 경우가 있어서, 컴포넌트만 붙어있으면
        // 항상 동작하도록 코드에서 직접 보정한다.
        if (hpSlider == null)
            hpSlider = GetComponent<Slider>();

        if (trailFillImage != null)
            trailFillImage.color = trailColor;
    }

    void OnEnable()
    {
        bossStats = null;
        InvokeRepeating(nameof(TryFindBoss), 0f, findRetryInterval);
    }

    void Update()
    {
        // 회복 중이거나 평소에는 잔상 바가 항상 현재 체력 바 값을 실시간으로 따라가게 해서
        // 초록(빨강) 바보다 앞서 나가는 일이 없게 한다. 데미지로 "천천히 따라 내려가는" 중일 땐 건드리지 않음.
        if (trailFillImage != null && hpSlider != null && !trailCatchingUp)
            SetTrailRatio(hpSlider.value);
    }

    void TryFindBoss()
    {
        if (bossStats != null)
        {
            CancelInvoke(nameof(TryFindBoss));
            return;
        }

        BossController boss = FindObjectOfType<BossController>();
        if (boss == null) return;

        Stats s = boss.GetComponent<Stats>();
        if (s == null) return;

        bossStats = s;
        bossStats.OnHpChanged += UpdateHp;

        // 처음 찾았을 때는 트윈 없이 바로 반영
        if (hpSlider != null)
        {
            hpSlider.DOKill();
            float ratio = bossStats.maxHp > 0 ? (float)bossStats.currentHp / bossStats.maxHp : 0f;
            hpSlider.value = ratio;

            if (trailFillImage != null)
            {
                trailFillImage.DOKill();
                trailCatchingUp = false;
                SetTrailRatio(ratio);
            }
        }

        bossRef = boss;
        bossRef.OnDied += HandleBossDied;

        CancelInvoke(nameof(TryFindBoss));
    }

    // 보스가 진짜로 사망하면(부활 전 임시 사망 말고) HP 캔버스 자체를 화면에서 치운다
    void HandleBossDied()
    {
        Canvas parentCanvas = GetComponentInParent<Canvas>(true);
        if (parentCanvas != null)
            parentCanvas.gameObject.SetActive(false);
        else
            gameObject.SetActive(false);
    }

    void UpdateHp(int current, int max)
    {
        if (hpSlider == null) return;

        float target = max > 0 ? (float)current / max : 0f;

        // 지금 화면에 보이는 값(이전 트윈이 아직 진행 중이었다면 그 중간값)을 기준으로 판단
        float beforeRatio = hpSlider.value;

        hpSlider.DOKill();
        hpSlider.DOValue(target, tweenDuration).SetEase(tweenEase);

        if (trailFillImage != null)
        {
            trailFillImage.DOKill();

            if (target < beforeRatio)
            {
                // 데미지: 잔상 바를 지금 값에 잠깐 고정해뒀다가, 살짝 대기 후 천천히 새 값까지 따라 내려간다.
                trailCatchingUp = true;
                SetTrailRatio(beforeRatio);
                DOTween.To(GetTrailRatio, SetTrailRatio, target, trailDuration)
                    .SetDelay(trailDelay)
                    .SetEase(Ease.OutQuad)
                    .SetTarget(trailFillImage)
                    .OnComplete(() => trailCatchingUp = false);
            }
            else
            {
                // 회복(또는 변화 없음): 잔상 없이 Update()가 매 프레임 체력 바를 그대로 따라가게 둔다.
                trailCatchingUp = false;
            }
        }
    }

    float GetTrailRatio()
    {
        if (trailFillImage == null) return 0f;
        return trailFillImage.rectTransform.anchorMax.x;
    }

    void SetTrailRatio(float ratio)
    {
        if (trailFillImage == null) return;
        RectTransform rt = trailFillImage.rectTransform;
        rt.anchorMin = new Vector2(0f, 0f);
        rt.anchorMax = new Vector2(Mathf.Clamp01(ratio), 1f);
    }

    void OnDisable()
    {
        CancelInvoke(nameof(TryFindBoss));
        if (hpSlider != null)
            hpSlider.DOKill();
        if (trailFillImage != null)
            trailFillImage.DOKill();
        if (bossStats != null)
            bossStats.OnHpChanged -= UpdateHp;
        bossStats = null;

        if (bossRef != null)
            bossRef.OnDied -= HandleBossDied;
        bossRef = null;
    }
}
