using System.Linq;
using UnityEditor;
using UnityEditor.Animations;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;
using UnityEngine.UI;
using UnityEngine.Rendering;
using UnityEngine.Rendering.Universal;

/// <summary>
/// 배경을 원경/중경/근경 3개의 레이어로 나눴을 때, 실제 3D 라이트를 레이어별로 따로
/// 적용할 수 있는지 + 오브젝트에 막히면 빛이 뒤로 안 넘어가는지 테스트하는 씬을 만드는 에디터 툴.
/// (예전엔 Light2D + Sorting Layer 기반이었는데, 실제 3D Light + Lit 셰이더 기반으로 전환함)
///   - 원경: 테스트용 모델 1 (Obj1_ExampleLow, MeshRenderer + Universal Render Pipeline/Lit + 노멀맵 + AO)
///   - 중경: 테스트용 모델 2 (Obj2_Wall, MeshRenderer + Lit + 노멀맵)
///   - 근경: 실제 여주인공 캐릭터 스프라이트 달리기 애니메이션 재생 (SpriteRenderer + Animator + Lit + 노멀맵, 림라이트 확인용)
///   - 위 3개를 각각 별도의 Unity Layer(원경/중경/근경)에 놓고, 그 레이어 하나만 cullingMask로
///     비추는 실제 Light(Point) 3개를 전부 같은 자리에 겹쳐서 배치한다.
/// -> 실제 게임의 InfiniteBackground.cs는 전부 같은 Sorting Layer(Default) 안에서
///    Sorting Order만 다르게 줘서 원근감을 내는 방식이라, 3D Light의 cullingMask로 레이어별로
///    다른 조명을 줄 수 있는지, 오브젝트가 뒤쪽 빛을 가려 그림자를 드리우는지 확인한다.
///
/// 실행: Tools > EventHorizon > 라이팅 테스트 씬 생성
/// 주의: Point/Spot 라이트 그림자를 보려면 URP 에셋(Assets/Settings/UniversalRP.asset)의
/// Additional Lights Shadows가 켜져 있어야 함(이 작업하면서 켜둠).
/// </summary>
public static class LightingTestSceneBuilder
{
    const string ScenePath = "Assets/0.Scenes/LightingTestScene.unity";
    const string RunAnimPath = "Assets/4. Art/anim/Sprites/female/animation/Run.anim";
    const string RunSpriteSheetPath = "Assets/4. Art/anim/Sprites/female/Sprites/Running_Sprite.png"; // 정지 프레임 비교용
    const string CharMat2DPath = "Assets/Settings/CharacterSpriteLit2DTest.mat"; // 근경(캐릭터 스프라이트)용

    const string SortingLayerFar = "원경";
    const string SortingLayerMid = "중경";
    const string SortingLayerNear = "근경";

    // 사용자가 올려준 실제 3D 모델 (예시 소품 + 벽) - 원경/중경으로 사용
    const string ModelDir = "Assets/test/LightingTest/";
    const string ExampleFbxPath = ModelDir + "Obj1_ExampleLow/ExampleLow.fbx";
    const string ExampleBaseColorPath = ModelDir + "Obj1_ExampleLow/ExampleLow_BaseColor.png";
    const string ExampleNormalPath = ModelDir + "Obj1_ExampleLow/ExampleLow_Normal.png";
    const string ExampleOcclusionPath = ModelDir + "Obj1_ExampleLow/DefaultMaterial_Mixed_AO.png"; // 추가된 AO(앰비언트 오클루전) 맵. Wall(중경)에는 AO 맵이 없어서 적용 안 함
    const string ExampleMatPath = ModelDir + "ExampleLowSpriteLit2DTest.mat";
    const string WallFbxPath = ModelDir + "Obj2_Wall/Wall.fbx";
    const string WallBaseColorPath = ModelDir + "Obj2_Wall/Wall_BaseColor.png";
    const string WallNormalPath = ModelDir + "Obj2_Wall/Wall_Normal.png";
    const string WallMatPath = ModelDir + "WallSpriteLit2DTest.mat";

    // 캐릭터 애니메이션(달리기) 노멀맵 - 3D 라이팅/림라이트 테스트용
    const string CharNormalMapPath = ModelDir + "CharacterNormalMaps/Running_Sprite_normal.png";
    // 근경 캐릭터가 정지 프레임이 아니라 실제로 달리기 애니메이션이 재생되도록 만드는 초간단 AnimatorController
    const string CharRunControllerPath = "Assets/Settings/CharacterRun3DTest.controller";
    // 노멀맵 강도(Lit 셰이더의 _BumpScale). 기본값 1보다 키워서 굴곡/림라이트 반응을 더 세게 보이게 함.
    const float NormalMapStrength = 2.5f;

    // 비교용: 왼쪽(노멀맵 없음)/오른쪽(다른 포즈) 캐릭터용 머티리얼, 오른쪽용 포즈 텍스처+노멀맵
    const string CharMatNoNormalPath = "Assets/Settings/CharacterLit3DTest_NoNormal.mat";
    const string CharMatPosePath = "Assets/Settings/CharacterLit3DTest_IdlePose.mat";
    const string IdlePosePath = "Assets/test/LightingTest/PoseCompare/Idle_Pose.png";
    const string IdlePoseNormalPath = "Assets/test/LightingTest/PoseCompare/Idle_Pose_normal.png";

    [MenuItem("Tools/EventHorizon/라이팅 테스트 씬 생성")]
    public static void Build()
    {
        var scene = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);

        // 씬 전역 기본광 - 아주 약하게만 켜서 테스트용 3D Light 3개가 더 잘 보이게 함
        var sunGO = new GameObject("Directional Light (Global, dim)");
        var sun = sunGO.AddComponent<Light>();
        sun.type = LightType.Directional;
        sun.intensity = 0.15f;
        sunGO.transform.rotation = Quaternion.Euler(50f, -30f, 0f);

        BuildBackgroundLayerLightingTest();
        BuildLabelUI();

        System.IO.Directory.CreateDirectory("Assets/0.Scenes");
        EditorSceneManager.MarkSceneDirty(scene);
        bool ok = EditorSceneManager.SaveScene(scene, ScenePath);
        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();

        if (ok)
            Debug.Log("[LightingTestSceneBuilder] 라이팅 테스트 씬 생성 완료: " + ScenePath);
        else
            Debug.LogError("[LightingTestSceneBuilder] 씬 저장 실패: " + ScenePath);
    }

    // ================= 배경 원경/중경/근경 레이어별 3D 라이팅 테스트 =================
    // 원경/중경/근경을 별도의 Unity Layer로 분리하고, 그 3개 레이어를 하나씩만 cullingMask로 노려서
    // 비추는 3D Light 3개를 전부 같은 자리에 겹쳐서 배치한다. 만약 레이어별 조명 분리가 실제로 되면
    // 겹쳐있어도 각 오브젝트는 자기 레이어를 노리는 라이트의 색으로만 물들어야 한다.
    static void BuildBackgroundLayerLightingTest()
    {
        Vector3 center = Vector3.zero;

        EnsureSortingLayer(SortingLayerFar);
        EnsureSortingLayer(SortingLayerMid);
        EnsureSortingLayer(SortingLayerNear);

        // 2D 라이팅(Light2D) 테스트 -> 3D 라이팅(실제 Light + Lit 셰이더) 테스트로 전환.
        // Lit 셰이더는 기본이 Cull Back + ZWrite On이라, 예전에 Sprite-Lit-Default에서 있었던
        // "뒷면이 비쳐 보이는" 문제 자체가 없어서 CullBackTest용 커스텀 셰이더가 더 필요 없다.
        Shader litShader = Shader.Find("Universal Render Pipeline/Lit");
        if (litShader == null)
        {
            Debug.LogError("[LightingTestSceneBuilder] 'Universal Render Pipeline/Lit' 셰이더를 못 찾음 - 3D 라이팅 테스트를 진행할 수 없음");
            return;
        }
        Shader modelShader = litShader;

        int layerFar = EnsureUnityLayer(SortingLayerFar);
        int layerMid = EnsureUnityLayer(SortingLayerMid);
        int layerNear = EnsureUnityLayer(SortingLayerNear);

        // 원경: 테스트용 모델 1 (ExampleLow) - MeshRenderer + Lit + 노멀맵 + AO
        var farGO = InstantiateModelWithLit(
            ExampleFbxPath, ExampleBaseColorPath, ExampleNormalPath, ExampleMatPath,
            "ExampleLowLit3DTest", modelShader, ExampleOcclusionPath);
        if (farGO != null)
        {
            farGO.name = "BG_원경(ExampleLow Model)";
            farGO.transform.position = center + new Vector3(-2f, 1f, 2f);
            farGO.transform.rotation = Quaternion.Euler(0f, 25f, 0f);
            NormalizeScaleToFit(farGO, targetSize: 3f);
            SetSortingLayerRecursive(farGO, SortingLayerFar);
            SetLayerRecursive(farGO, layerFar);
        }

        // 중경: 테스트용 모델 2 (Wall) - MeshRenderer + Lit + 노멀맵
        var midGO = InstantiateModelWithLit(
            WallFbxPath, WallBaseColorPath, WallNormalPath, WallMatPath,
            "WallLit3DTest", modelShader);
        if (midGO != null)
        {
            midGO.name = "BG_중경(Wall Model)";
            midGO.transform.position = center + new Vector3(1.5f, -0.3f, 0.5f);
            midGO.transform.rotation = Quaternion.Euler(0f, -20f, 0f);
            NormalizeScaleToFit(midGO, targetSize: 4f);
            SetSortingLayerRecursive(midGO, SortingLayerMid);
            SetLayerRecursive(midGO, layerMid);
        }

        // 근경: 실제 캐릭터 스프라이트(달리기 애니메이션 재생) - SpriteRenderer + Animator + Lit + 노멀맵
        Material charMat = AssetDatabase.LoadAssetAtPath<Material>(CharMat2DPath);
        if (charMat == null)
        {
            charMat = new Material(litShader) { name = "CharacterLit3DTest" };
            AssetDatabase.CreateAsset(charMat, CharMat2DPath);
        }
        else
        {
            charMat.shader = litShader;
        }

        // 스프라이트 배경(투명)이 알파로 잘려나가도록 Alpha Clipping 켬(Opaque + Alpha Clip 조합)
        ConfigureAlphaClipCharMaterial(charMat);

        var nearGO = new GameObject("BG_근경(Character Sprite)");
        nearGO.transform.position = center + new Vector3(0f, -1.6f, -2f);
        var sr = nearGO.AddComponent<SpriteRenderer>();
        sr.sharedMaterial = charMat;
        var runClip = AssetDatabase.LoadAssetAtPath<AnimationClip>(RunAnimPath);
        sr.sprite = GetFirstSpriteOfClip(runClip);
        if (sr.sprite == null)
            Debug.LogWarning("[LightingTestSceneBuilder] Run.anim에서 스프라이트를 못 찾음: " + RunAnimPath);
        sr.sortingLayerName = SortingLayerNear;
        nearGO.layer = layerNear;
        sr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.On;
        sr.receiveShadows = true;

        // 정지 프레임이 아니라 실제 달리기 애니메이션이 재생되도록 Animator 장착.
        // AnimatorController가 없으면 Run.anim 하나만 도는 아주 단순한 컨트롤러를 새로 만들어서 씀.
        var animator = nearGO.AddComponent<Animator>();
        var runController = AssetDatabase.LoadAssetAtPath<RuntimeAnimatorController>(CharRunControllerPath);
        if (runController == null && runClip != null)
            runController = AnimatorController.CreateAnimatorControllerAtPathWithClip(CharRunControllerPath, runClip);
        animator.runtimeAnimatorController = runController;
        if (runController == null)
            Debug.LogWarning("[LightingTestSceneBuilder] 캐릭터 AnimatorController를 못 만듦(Run.anim 못 찾음?) - 정지 프레임으로만 보일 수 있음");

        // SpriteRenderer는 Sprite-Lit-Default 계열 셰이더에서만 자동으로 _MainTex를 채워주고,
        // 표준 Lit 셰이더는 실제로 _BaseMap을 샘플링하므로 스프라이트 텍스처를 직접 넣어줘야 함.
        if (charMat.HasProperty("_BaseMap") && sr.sprite != null)
            charMat.SetTexture("_BaseMap", sr.sprite.texture);

        // 캐릭터 애니메이션(달리기) 노멀맵 - 림라이트/입체감용
        EnsureNormalMapImportSettings(CharNormalMapPath);
        var charNormalTex = AssetDatabase.LoadAssetAtPath<Texture2D>(CharNormalMapPath);
        if (charNormalTex == null)
        {
            Debug.LogWarning("[LightingTestSceneBuilder] 캐릭터 노멀맵을 못 찾음(유니티 에디터에 포커스를 한번 줘서 " +
                "새로 넣은 텍스처가 임포트되게 한 다음 다시 실행해야 할 수 있음): " + CharNormalMapPath);
        }
        if (charMat.HasProperty("_BumpMap"))
        {
            charMat.SetTexture("_BumpMap", charNormalTex);
            if (charNormalTex != null) charMat.EnableKeyword("_NORMALMAP");
        }
        if (charMat.HasProperty("_BumpScale")) charMat.SetFloat("_BumpScale", NormalMapStrength);

        // 왼쪽: 가운데랑 같은 달리기 애니메이션/베이스 텍스처를 쓰되 노멀맵만 뺀 버전(비교용).
        Material charMatNoNormal = AssetDatabase.LoadAssetAtPath<Material>(CharMatNoNormalPath);
        if (charMatNoNormal == null)
        {
            charMatNoNormal = new Material(litShader) { name = "CharacterLit3DTest_NoNormal" };
            AssetDatabase.CreateAsset(charMatNoNormal, CharMatNoNormalPath);
        }
        else
        {
            charMatNoNormal.shader = litShader;
        }
        ConfigureAlphaClipCharMaterial(charMatNoNormal);
        if (charMatNoNormal.HasProperty("_BaseMap") && sr.sprite != null)
            charMatNoNormal.SetTexture("_BaseMap", sr.sprite.texture);
        if (charMatNoNormal.HasProperty("_BumpMap")) charMatNoNormal.SetTexture("_BumpMap", null);
        charMatNoNormal.DisableKeyword("_NORMALMAP");

        var runSprite0 = AssetDatabase.LoadAllAssetsAtPath(RunSpriteSheetPath)
            .OfType<Sprite>().FirstOrDefault(s => s.name == "Running_Sprite_0");
        CreateCompareCharacter("BG_근경_비교_왼쪽(노멀맵 없음)", center + new Vector3(-1.8f, -1.6f, -2f),
            charMatNoNormal, runSprite0, runController, layerNear, SortingLayerNear);

        // 오른쪽: 다른 포즈(대기 자세, Idle_Pose.png) + 그 포즈 전용으로 새로 만든 노멀맵.
        // Run.anim이랑 무관한 정지 이미지라 Animator 없이 스프라이트 하나만 고정으로 둠.
        EnsureSpriteImportSettings(IdlePosePath);
        var idleSprite = AssetDatabase.LoadAssetAtPath<Sprite>(IdlePosePath);
        if (idleSprite == null)
            Debug.LogWarning("[LightingTestSceneBuilder] 대기 포즈 스프라이트를 못 찾음(에디터 포커스 후 재실행 필요할 수 있음): " + IdlePosePath);

        EnsureNormalMapImportSettings(IdlePoseNormalPath);
        var idleNormalTex = AssetDatabase.LoadAssetAtPath<Texture2D>(IdlePoseNormalPath);

        Material charMatPose = AssetDatabase.LoadAssetAtPath<Material>(CharMatPosePath);
        if (charMatPose == null)
        {
            charMatPose = new Material(litShader) { name = "CharacterLit3DTest_IdlePose" };
            AssetDatabase.CreateAsset(charMatPose, CharMatPosePath);
        }
        else
        {
            charMatPose.shader = litShader;
        }
        ConfigureAlphaClipCharMaterial(charMatPose);
        if (charMatPose.HasProperty("_BaseMap") && idleSprite != null)
            charMatPose.SetTexture("_BaseMap", idleSprite.texture);
        if (charMatPose.HasProperty("_BumpMap"))
        {
            charMatPose.SetTexture("_BumpMap", idleNormalTex);
            if (idleNormalTex != null) charMatPose.EnableKeyword("_NORMALMAP");
        }
        if (charMatPose.HasProperty("_BumpScale")) charMatPose.SetFloat("_BumpScale", NormalMapStrength);

        CreateCompareCharacter("BG_근경_비교_오른쪽(대기 포즈)", center + new Vector3(1.8f, -1.6f, -2f),
            charMatPose, idleSprite, null, layerNear, SortingLayerNear);

        // 라이트 3개를 전부 같은 자리에, 세 레이어를 다 덮을 만큼 넉넉한 반경으로 겹쳐서 배치.
        // (레이어 제한이 안 먹으면 세 오브젝트가 전부 세 색으로 뒤섞여 보일 것이다)
        CreateLayerTestLight3D("Light3D_원경만", center, new Color(0.4f, 0.6f, 1f), layerFar);
        CreateLayerTestLight3D("Light3D_중경만", center, new Color(0.5f, 1f, 0.5f), layerMid);
        // 근경만은 캐릭터 바로 코앞(거리 1)에 있어서 세기가 15면 정면을 너무 세게 태워서
        // 림라이트가 파묻혀 안 보임 - 약한 정면 필라이트 정도로만 쓰이게 세기를 확 낮춤
        CreateLayerTestLight3D("Light3D_근경만", center, new Color(1f, 0.6f, 0.3f), layerNear, intensity: 3f);

        // 위 3개는 "레이어별로 다른 라이트가 따로 비치는지"만 확인하는 용도라 캐릭터 정면(z=-3)에
        // 가깝게 떠 있어서, 정작 노멀맵의 림라이트 효과(테두리만 밝게 튀는 것)는 잘 안 보인다.
        // 그래서 근경 캐릭터 3개 전용으로 "뒤쪽"(z=+2.5, 캐릭터보다 카메라에서 먼 쪽)에서
        // 비추는 백라이트를 따로 추가 - 이게 있어야 노멀맵으로 굽어진 실루엣 가장자리에 빛이
        // 걸리면서 진짜 림라이트처럼 보인다.
        // 근경만 라이트(정면광)를 약하게 낮춘 만큼, 백라이트는 캐릭터한테 더 가깝고 더 세게 줘서
        // 정면광보다 확실히 우세하게 만듦 - 그래야 몸통은 어둡고 테두리만 밝은 "림라이트" 느낌이 남.
        //
        // 중요: Point 라이트는 방향이 없고 위치만 밝기에 영향을 준다. 노멀맵이 테두리 전체에서
        // 방사형으로(사방으로) 바깥을 향해 굽어있기 때문에, 라이트를 캐릭터 정면/후면 축(z)에만
        // 두면 테두리 전체가 고르게 빛나는 "도넛 모양 후광"처럼 보인다. 실제 림라이트처럼
        // "빛을 받는 한쪽만" 밝게 하려면 z뿐 아니라 x/y로도 확실히 치우친 위치에 둬야 함
        // (조명 자체에 그런 기능이 있는 게 아니라 순전히 라이트를 어디 두느냐의 문제).
        var backGO = new GameObject("Light3D_근경_백라이트(림라이트용)");
        backGO.transform.position = center + new Vector3(1.4f, 1.6f, 1.4f);
        backGO.transform.LookAt(center + new Vector3(0f, -1.6f, -2f));
        var back = backGO.AddComponent<Light>();
        back.type = LightType.Point;
        back.color = new Color(0.55f, 0.8f, 1f); // 시원한 느낌의 림라이트 색
        back.intensity = 90f;
        back.range = 14f;
        back.cullingMask = 1 << layerNear; // 원경/중경한테는 안 비치고 근경 캐릭터 3개한테만

        var camGO = new GameObject("Camera_3DRenderer_BGLayers");
        var cam = camGO.AddComponent<Camera>();
        cam.orthographic = true;
        cam.orthographicSize = 4f;
        camGO.transform.position = center + new Vector3(0f, 0f, -10f);
        cam.clearFlags = CameraClearFlags.SolidColor;
        cam.backgroundColor = new Color(0.05f, 0.05f, 0.05f);
        var camData = cam.GetUniversalAdditionalCameraData();
        // Renderer3D_LightingTest = Assets/Settings/Renderer3D_LightingTest.asset
        // (URP 에셋 UniversalRP.asset의 m_RendererDataList 인덱스 1) - 실제 3D Light가 작동하는 Universal Renderer.
        camData.SetRenderer(1);
    }

    // 인스턴스화된 모델(자식에 Renderer가 여러 개 있을 수 있음) 전체에 같은 Sorting Layer를 적용.
    static void SetSortingLayerRecursive(GameObject go, string sortingLayerName)
    {
        var renderers = go.GetComponentsInChildren<Renderer>();
        foreach (var r in renderers) r.sortingLayerName = sortingLayerName;
    }

    // 실제 3D Light(Point)를 만들어서 cullingMask로 딱 하나의 Unity Layer에만 영향을 주도록 제한.
    // Light2D의 "Target Sorting Layers"와 같은 역할을 3D 라이트의 cullingMask로 구현한 버전.
    static void CreateLayerTestLight3D(string name, Vector3 center, Color color, int targetLayer, float intensity = 15f)
    {
        var go = new GameObject(name);
        go.transform.position = center + new Vector3(0f, 0f, -3f);
        go.transform.LookAt(center);
        var light = go.AddComponent<Light>();
        light.type = LightType.Point;
        light.color = color;
        light.intensity = intensity;
        light.range = 12f;
        light.cullingMask = 1 << targetLayer;
        // 오브젝트가 다른 오브젝트의 뒤쪽 빛을 가려서 그림자를 드리우는지(빛이 안 넘어가는지) 확인
        light.shadows = LightShadows.Soft;
        var ping = go.AddComponent<LightPingPong>();
        ping.distance = 5f;
        ping.speed = 1f;
    }

    // Tags & Layers 인스펙터에서 빈 유저 레이어(8~31번)에 이름을 채워넣는 것과 같은 효과를 스크립트로 실행.
    // 이미 같은 이름의 레이어가 있으면 그 인덱스를 그대로 반환(재실행해도 중복 생성되지 않음).
    static int EnsureUnityLayer(string layerName)
    {
        var tagManagerAssets = AssetDatabase.LoadAllAssetsAtPath("ProjectSettings/TagManager.asset");
        if (tagManagerAssets == null || tagManagerAssets.Length == 0)
        {
            Debug.LogError("[LightingTestSceneBuilder] ProjectSettings/TagManager.asset을 못 찾음 - Layer(" + layerName + ")를 추가하지 못함");
            return 0;
        }

        var so = new SerializedObject(tagManagerAssets[0]);
        var layersProp = so.FindProperty("layers");
        if (layersProp == null)
        {
            Debug.LogError("[LightingTestSceneBuilder] TagManager.asset의 layers 필드를 못 찾음(유니티 버전 차이?)");
            return 0;
        }

        for (int i = 8; i < layersProp.arraySize; i++)
        {
            if (layersProp.GetArrayElementAtIndex(i).stringValue == layerName)
                return i; // 이미 존재함 - 그대로 반환(멱등)
        }

        for (int i = 8; i < layersProp.arraySize; i++)
        {
            var element = layersProp.GetArrayElementAtIndex(i);
            if (string.IsNullOrEmpty(element.stringValue))
            {
                element.stringValue = layerName;
                so.ApplyModifiedProperties();
                AssetDatabase.SaveAssets();
                return i;
            }
        }

        Debug.LogError("[LightingTestSceneBuilder] 빈 Layer 슬롯이 없어서 '" + layerName + "' 레이어를 추가하지 못함(8~31번 레이어가 모두 사용 중)");
        return 0;
    }

    // 인스턴스화된 모델(자식에 GameObject가 여러 개 있을 수 있음) 전체에 같은 Unity Layer를 적용.
    // (Light.cullingMask가 GameObject.layer를 기준으로 판정하기 때문에 자식까지 다 맞춰줘야 함)
    static void SetLayerRecursive(GameObject go, int layer)
    {
        go.layer = layer;
        var children = go.GetComponentsInChildren<Transform>(true);
        foreach (var child in children) child.gameObject.layer = layer;
    }

    // Tags & Layers 인스펙터에서 "+"로 Sorting Layer를 추가하는 것과 같은 효과를 스크립트로 실행.
    // 이미 같은 이름의 레이어가 있으면 그대로 두고 반환(재실행해도 중복 생성되지 않음).
    static void EnsureSortingLayer(string layerName)
    {
        var tagManagerAssets = AssetDatabase.LoadAllAssetsAtPath("ProjectSettings/TagManager.asset");
        if (tagManagerAssets == null || tagManagerAssets.Length == 0)
        {
            Debug.LogError("[LightingTestSceneBuilder] ProjectSettings/TagManager.asset을 못 찾음 - Sorting Layer(" + layerName + ")를 추가하지 못함");
            return;
        }

        var so = new SerializedObject(tagManagerAssets[0]);
        var layersProp = so.FindProperty("m_SortingLayers");
        if (layersProp == null)
        {
            Debug.LogError("[LightingTestSceneBuilder] TagManager.asset의 m_SortingLayers 필드를 못 찾음(유니티 버전 차이?)");
            return;
        }

        int maxId = 0;
        for (int i = 0; i < layersProp.arraySize; i++)
        {
            var element = layersProp.GetArrayElementAtIndex(i);
            var nameProp = element.FindPropertyRelative("name");
            if (nameProp != null && nameProp.stringValue == layerName)
                return; // 이미 존재함 - 아무것도 안 함(멱등)

            var idProp = element.FindPropertyRelative("uniqueID");
            if (idProp != null) maxId = Mathf.Max(maxId, idProp.intValue);
        }

        int newIndex = layersProp.arraySize;
        layersProp.InsertArrayElementAtIndex(newIndex);
        var newElement = layersProp.GetArrayElementAtIndex(newIndex);
        newElement.FindPropertyRelative("name").stringValue = layerName;
        // InsertArrayElementAtIndex가 바로 앞 요소 값을 복제해서 넣기 때문에 uniqueID가 겹칠 수 있어 새로 배정.
        var newIdProp = newElement.FindPropertyRelative("uniqueID");
        if (newIdProp != null) newIdProp.intValue = maxId + 1;
        var lockedProp = newElement.FindPropertyRelative("locked");
        if (lockedProp != null) lockedProp.boolValue = false;

        so.ApplyModifiedProperties();
        AssetDatabase.SaveAssets();
    }

    // ================= 실제 FBX 모델을 임포트해서 Lit 머티리얼을 입힌 인스턴스로 반환 =================
    static GameObject InstantiateModelWithLit(string fbxPath, string baseColorPath, string normalPath,
        string matPath, string matName, Shader litShader, string occlusionPath = null)
    {
        var prefab = AssetDatabase.LoadAssetAtPath<GameObject>(fbxPath);
        if (prefab == null)
        {
            Debug.LogError("[LightingTestSceneBuilder] 모델(FBX)을 못 찾음: " + fbxPath);
            return null;
        }

        EnsureNormalMapImportSettings(normalPath);

        var baseColorTex = AssetDatabase.LoadAssetAtPath<Texture2D>(baseColorPath);
        var normalTex = AssetDatabase.LoadAssetAtPath<Texture2D>(normalPath);
        if (baseColorTex == null)
            Debug.LogWarning("[LightingTestSceneBuilder] 베이스컬러 텍스처를 못 찾음: " + baseColorPath);
        if (normalTex == null)
            Debug.LogWarning("[LightingTestSceneBuilder] 노멀맵 텍스처를 못 찾음: " + normalPath);

        Texture2D occlusionTex = null;
        if (!string.IsNullOrEmpty(occlusionPath))
        {
            occlusionTex = AssetDatabase.LoadAssetAtPath<Texture2D>(occlusionPath);
            if (occlusionTex == null)
                Debug.LogWarning("[LightingTestSceneBuilder] AO(앰비언트 오클루전) 텍스처를 못 찾음: " + occlusionPath);
        }

        Material mat = AssetDatabase.LoadAssetAtPath<Material>(matPath);
        if (mat == null)
        {
            mat = new Material(litShader) { name = matName };
            AssetDatabase.CreateAsset(mat, matPath);
        }
        else
        {
            mat.shader = litShader;
        }
        // Lit 셰이더는 실제로 _BaseMap/_BumpMap을 샘플링함(_MainTex/_NormalMap은 예전 2D 셰이더 전용 이름)
        if (mat.HasProperty("_BaseMap")) mat.SetTexture("_BaseMap", baseColorTex);
        if (mat.HasProperty("_BumpMap"))
        {
            mat.SetTexture("_BumpMap", normalTex);
            if (normalTex != null) mat.EnableKeyword("_NORMALMAP");
        }
        if (mat.HasProperty("_BumpScale")) mat.SetFloat("_BumpScale", NormalMapStrength);
        // occlusionTex가 null이면 셰이더 프로퍼티 기본값인 흰색(1.0)이 그대로 적용되어 AO 없음과 동일하게 동작함
        if (mat.HasProperty("_OcclusionMap")) mat.SetTexture("_OcclusionMap", occlusionTex);

        var instance = (GameObject)PrefabUtility.InstantiatePrefab(prefab);
        instance.name = matName + "_Instance";

        var renderers = instance.GetComponentsInChildren<Renderer>();
        if (renderers.Length == 0)
            Debug.LogWarning("[LightingTestSceneBuilder] " + fbxPath + " 안에 Renderer가 하나도 없음(빈 모델?)");

        foreach (var renderer in renderers)
        {
            var mats = renderer.sharedMaterials;
            for (int i = 0; i < mats.Length; i++) mats[i] = mat;
            if (mats.Length == 0) mats = new[] { mat };
            renderer.sharedMaterials = mats;

            // 실제 3D 그림자 캐스팅/수신 - MeshRenderer 기본값이지만 명시적으로 켜둠
            renderer.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.On;
            renderer.receiveShadows = true;
        }

        return instance;
    }

    // 노멀맵 텍스처를 "Normal map" 타입으로 강제 - 그래야 셰이더의 UnpackNormal이 제대로 해석함.
    // (기본값인 Default/sRGB 상태로 두면 노멀맵이 이상하게 뭉개져 보임)
    // + 밉맵을 꺼줌 - 캐릭터 노멀맵처럼 스프라이트시트(여러 애니메이션 프레임이 한 텍스처 안에 같이
    // 들어있는 경우) 텍스처는 밉맵이 켜져있으면 낮은 밉 레벨에서 옆 프레임 데이터가 섞여 들어와서
    // (밉 블리딩) 캐릭터 위에 실제 포즈랑 안 맞는 이상한 줄무늬 빛/그림자로 보이는 문제가 생긴다.
    static void EnsureNormalMapImportSettings(string texPath)
    {
        var importer = AssetImporter.GetAtPath(texPath) as TextureImporter;
        if (importer == null) return;
        bool changed = false;
        if (importer.textureType != TextureImporterType.NormalMap)
        {
            importer.textureType = TextureImporterType.NormalMap;
            changed = true;
        }
        if (importer.mipmapEnabled)
        {
            importer.mipmapEnabled = false;
            changed = true;
        }
        if (changed)
            importer.SaveAndReimport();
    }

    // 실제 모델의 임포트 스케일(단위)을 모르는 상태이므로, 렌더러들의 합산 바운드를 기준으로
    // 화면에 보기 좋은 크기가 되도록 오브젝트를 자동으로 스케일링.
    static void NormalizeScaleToFit(GameObject target, float targetSize)
    {
        var renderers = target.GetComponentsInChildren<Renderer>();
        if (renderers.Length == 0) return;

        Bounds b = renderers[0].bounds;
        foreach (var r in renderers) b.Encapsulate(r.bounds);

        float maxDim = Mathf.Max(b.size.x, Mathf.Max(b.size.y, b.size.z));
        if (maxDim <= 0.0001f) return;

        float scale = targetSize / maxDim;
        target.transform.localScale = target.transform.localScale * scale;
    }

    static Sprite GetFirstSpriteOfClip(AnimationClip clip)
    {
        if (clip == null) return null;
        var bindings = AnimationUtility.GetObjectReferenceCurveBindings(clip);
        foreach (var binding in bindings)
        {
            var keyframes = AnimationUtility.GetObjectReferenceCurve(clip, binding);
            if (keyframes != null && keyframes.Length > 0)
                return keyframes[0].value as Sprite;
        }
        return null;
    }

    // 노멀맵 비교용 캐릭터를 하나 더 세운다. runController가 있으면 가운데 캐릭터처럼 Animator로
    // 애니메이션을 재생하고, null이면 initialSprite 하나로 고정된 정지 포즈로 남는다.
    static void CreateCompareCharacter(string name, Vector3 position, Material sharedMat,
        Sprite initialSprite, RuntimeAnimatorController runController, int layer, string sortingLayer)
    {
        var go = new GameObject(name);
        go.transform.position = position;
        go.layer = layer;
        var sr = go.AddComponent<SpriteRenderer>();
        sr.sharedMaterial = sharedMat;
        sr.sprite = initialSprite;
        sr.sortingLayerName = sortingLayer;
        sr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.On;
        sr.receiveShadows = true;

        if (runController != null)
        {
            var animator = go.AddComponent<Animator>();
            animator.runtimeAnimatorController = runController;
        }
    }

    // charMat 계열 머티리얼 공통 세팅: 스프라이트 배경(투명)이 알파로 잘려나가게 Alpha Clipping 켜고,
    // 완전 무광이면 백라이트 반사가 안 보이므로 스무스니스도 살짝 줌.
    static void ConfigureAlphaClipCharMaterial(Material mat)
    {
        if (mat.HasProperty("_AlphaClip")) mat.SetFloat("_AlphaClip", 1f);
        if (mat.HasProperty("_Cutoff")) mat.SetFloat("_Cutoff", 0.5f);
        mat.EnableKeyword("_ALPHATEST_ON");
        mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.AlphaTest;
        if (mat.HasProperty("_Smoothness")) mat.SetFloat("_Smoothness", 0.35f);
        if (mat.HasProperty("_Metallic")) mat.SetFloat("_Metallic", 0f);
    }

    // 원본 캐릭터 스프라이트들(Running_Sprite.png 등)이 쓰는 Pixels Per Unit 값. 새로 넣는
    // 포즈 텍스처도 이 값으로 맞춰야 화면에서 크기가 안 튀고 다른 캐릭터랑 같은 스케일로 보임.
    const float CharacterSpritePixelsPerUnit = 700f;

    // 새 스프라이트 텍스처를 "Sprite (2D and UI)" 단일 스프라이트 타입으로 강제하고, 기존 캐릭터
    // 스프라이트들이랑 같은 Pixels Per Unit으로 맞춰서 크기가 어긋나지 않게 함.
    static void EnsureSpriteImportSettings(string texPath)
    {
        var importer = AssetImporter.GetAtPath(texPath) as TextureImporter;
        if (importer == null) return;
        bool changed = false;
        if (importer.textureType != TextureImporterType.Sprite)
        {
            importer.textureType = TextureImporterType.Sprite;
            changed = true;
        }
        if (importer.spriteImportMode != SpriteImportMode.Single)
        {
            importer.spriteImportMode = SpriteImportMode.Single;
            changed = true;
        }
        if (!Mathf.Approximately(importer.spritePixelsPerUnit, CharacterSpritePixelsPerUnit))
        {
            importer.spritePixelsPerUnit = CharacterSpritePixelsPerUnit;
            changed = true;
        }
        if (changed)
            importer.SaveAndReimport();
    }

    // ================= 안내 라벨 (Screen Space Overlay라 렌더러 종류와 무관하게 항상 위에 표시) =================
    static void BuildLabelUI()
    {
        var canvasGO = new GameObject("Canvas", typeof(Canvas), typeof(CanvasScaler), typeof(GraphicRaycaster));
        var canvas = canvasGO.GetComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        var scaler = canvasGO.GetComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920f, 1080f);

        if (Object.FindObjectOfType<UnityEngine.EventSystems.EventSystem>() == null)
        {
            new GameObject("EventSystem",
                typeof(UnityEngine.EventSystems.EventSystem),
                typeof(UnityEngine.EventSystems.StandaloneInputModule));
        }

        CreateLabel(canvasGO.transform, "Label_Info",
            "배경 원경/중경/근경 레이어별 3D 라이팅 테스트\n" +
            "원경 = ExampleLow 모델, 중경 = Wall 모델, 근경 = 캐릭터 스프라이트\n" +
            "(레이어마다 다른 3D Light 1개씩, cullingMask로 제한)",
            new Vector2(0f, 1f), 1f);
    }

    static void CreateLabel(Transform parent, string name, string text, Vector2 anchor, float widthFrac)
    {
        var go = new GameObject(name, typeof(Text));
        go.transform.SetParent(parent, false);
        var t = go.GetComponent<Text>();
        t.text = text;
        t.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        t.fontSize = 22;
        t.color = Color.white;
        t.alignment = TextAnchor.UpperLeft;
        var rt = t.rectTransform;
        rt.anchorMin = anchor;
        rt.anchorMax = new Vector2(anchor.x + widthFrac, 1f);
        rt.pivot = new Vector2(0f, 1f);
        rt.anchoredPosition = new Vector2(20f, -20f);
        rt.sizeDelta = new Vector2(-40f, 100f);
    }

